# Configure these on a PRIVATE Node server, never in GitHub Pages.
LLM_PROVIDER=compatible
LLM_API_URL=https://your-gateway.example/v1/chat/completions
LLM_MODEL=your-model
LLM_API_KEY=replace-with-private-secret
PORT=3000

# 외부 공개 서버에 노출할 때 반드시 설정 (localhost 개발은 생략 가능)
HOST=127.0.0.1
AI_ALLOWED_ORIGINS=https://dodam-heo.github.io
# 비밀 환경변수에 저장: 32자 이상 권장, 클라이언트 HTML에 포함하지 않음
AI_ACCESS_TOKEN=
