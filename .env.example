# Local private AI backend only. NEVER commit the real .env file or API keys.
# Provider is selected on the server; the browser never depends on a model.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
GEMINI_API_KEY=REPLACE_WITH_YOUR_PRIVATE_GEMINI_API_KEY
LLM_TIMEOUT_MS=45000
PORT=3000
HOST=127.0.0.1

# Public deployment: set HOST=0.0.0.0 and a long private AI_ACCESS_TOKEN.
# Only allow the contest demo front-end origin:
AI_ALLOWED_ORIGINS=https://dodam-heo.github.io
AI_ACCESS_TOKEN=

# Change provider without touching the web UI:
# LLM_PROVIDER=compatible
# LLM_API_URL=https://your-gateway.example/v1/chat/completions
# LLM_MODEL=your-model
# LLM_API_KEY=REPLACE_WITH_PRIVATE_KEY
# Or LLM_PROVIDER=anthropic with LLM_API_KEY, LLM_MODEL.
